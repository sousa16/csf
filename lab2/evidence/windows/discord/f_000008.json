[{"id": "1541831882838748088", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "749909204537115799", "username": "DuckyDonald", "global_name": "Duckydonald", "discriminator": "0", "avatar": "38cbd95d0096d9ff122bdd7bfe78816c", "public_flags": 0, "bot": false}, "content": "Tiago Sintaxe", "timestamp": "2026-08-25T16:29:26.719000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541831824887365309", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "710261379959798783", "username": "Johnny", "global_name": "Johnny", "discriminator": "0", "avatar": "20b66b7b4e9e6f2733c50cc8233bce28", "public_flags": 0, "bot": false}, "content": "Who?", "timestamp": "2026-08-25T16:29:12.903000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541831541894034264", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "749909204537115799", "username": "DuckyDonald", "global_name": "Duckydonald", "discriminator": "0", "avatar": "38cbd95d0096d9ff122bdd7bfe78816c", "public_flags": 0, "bot": false}, "content": "i hope not. but there is one more thing you need to know before any of that happens. if you go to the police you have to know who you are talking about", "timestamp": "2026-08-25T16:28:05.432000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541831401058121370", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "710261379959798783", "username": "Johnny", "global_name": "Johnny", "discriminator": "0", "avatar": "20b66b7b4e9e6f2733c50cc8233bce28", "public_flags": 0, "bot": false}, "content": "You're scaring me. Nothing is going to happen to you.", "timestamp": "2026-08-25T16:27:31.854000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541831187572594774", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "749909204537115799", "username": "DuckyDonald", "global_name": "Duckydonald", "discriminator": "0", "avatar": "38cbd95d0096d9ff122bdd7bfe78816c", "public_flags": 0, "bot": false}, "content": "you dont understand what these people are. i shouldnt have told you anything, i pulled you into this for nothing. keep the usb somewhere safe and offline, dont open it again and dont tell anyone about it. if i stop answering, or if i disappear for a few days, go to the police and give them the usb. tell them everything, from the start. they will know what to do with those files", "timestamp": "2026-08-25T16:26:40.955000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541830844387448603", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "710261379959798783", "username": "Johnny", "global_name": "Johnny", "discriminator": "0", "avatar": "20b66b7b4e9e6f2733c50cc8233bce28", "public_flags": 0, "bot": false}, "content": "Don't say that. I deleted everything, nobody even knows those files exist. Nobody knows about me either.", "timestamp": "2026-08-25T16:25:19.133000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541830479118538857", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "749909204537115799", "username": "DuckyDonald", "global_name": "Duckydonald", "discriminator": "0", "avatar": "38cbd95d0096d9ff122bdd7bfe78816c", "public_flags": 0, "bot": false}, "content": "of course it does. check it, delete what you find, do whatever you want. it doesnt change anything anymore. if they were already watching me then its over. im done", "timestamp": "2026-08-25T16:23:52.046000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541830411032257180", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "710261379959798783", "username": "Johnny", "global_name": "Johnny", "discriminator": "0", "avatar": "20b66b7b4e9e6f2733c50cc8233bce28", "public_flags": 0, "bot": false}, "content": "...my site. It merges from there. I need to check it.", "timestamp": "2026-08-25T16:23:35.813000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541830177220367147", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "749909204537115799", "username": "DuckyDonald", "global_name": "Duckydonald", "discriminator": "0", "avatar": "38cbd95d0096d9ff122bdd7bfe78816c", "public_flags": 0, "bot": false}, "content": "gone from your disk. its not gone from wherever that thing pushes to, and its not gone from anything that pulls from it. do you have anything that pulls from that repo", "timestamp": "2026-08-25T16:22:40.068000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541830024469209533", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "710261379959798783", "username": "Johnny", "global_name": "Johnny", "discriminator": "0", "avatar": "20b66b7b4e9e6f2733c50cc8233bce28", "public_flags": 0, "bot": false}, "content": "I'm going to srm the whole repos folder right now, the repo with it. It'll be gone.", "timestamp": "2026-08-25T16:22:03.650000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541829837346049518", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "749909204537115799", "username": "DuckyDonald", "global_name": "Duckydonald", "discriminator": "0", "avatar": "38cbd95d0096d9ff122bdd7bfe78816c", "public_flags": 0, "bot": false}, "content": "thats the problem with you. you never think. youre not even dumb by accident, you work at it. i spent weeks being careful, no email, no cloud, a locker with a code, and you undid all of it in one afternoon because you couldnt remember your own script", "timestamp": "2026-08-25T16:21:19.036000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541829692307600256", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "710261379959798783", "username": "Johnny", "global_name": "Johnny", "discriminator": "0", "avatar": "20b66b7b4e9e6f2733c50cc8233bce28", "public_flags": 0, "bot": false}, "content": "I know. I know. I forgot about the sync, I was thinking about hiding them properly like you told me.", "timestamp": "2026-08-25T16:20:44.456000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541829300049857762", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "749909204537115799", "username": "DuckyDonald", "global_name": "Duckydonald", "discriminator": "0", "avatar": "38cbd95d0096d9ff122bdd7bfe78816c", "public_flags": 0, "bot": false}, "content": "are you fuck*** serious. i asked you for ONE thing. one. keep them offline. and you push them to git like a fuck*** idiot. you hid them and then you uploaded them. do you get that? you published them", "timestamp": "2026-08-25T16:19:10.935000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541829022955187721", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "710261379959798783", "username": "Johnny", "global_name": "Johnny", "discriminator": "0", "avatar": "20b66b7b4e9e6f2733c50cc8233bce28", "public_flags": 0, "bot": false}, "content": "Ducky wait. Before wiping I went to check the personal folder and I ran git status there. The files with the stuff inside are already committed. All of them. That folder is a repo. I have a script that commits and pushes it every time I open a terminal, it's been doing that for months, I completely forgot about it. Every time I hid one of your files and saved it, the sync took it with the rest.", "timestamp": "2026-08-25T16:18:04.870000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541828550057522410", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "749909204537115799", "username": "DuckyDonald", "global_name": "Duckydonald", "discriminator": "0", "avatar": "38cbd95d0096d9ff122bdd7bfe78816c", "public_flags": 0, "bot": false}, "content": "ok. thank you for doing it", "timestamp": "2026-08-25T16:16:12.122000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}, {"id": "1541828395910382820", "type": 0, "channel_id": "1284593260956792349", "author": {"id": "710261379959798783", "username": "Johnny", "global_name": "Johnny", "discriminator": "0", "avatar": "20b66b7b4e9e6f2733c50cc8233bce28", "public_flags": 0, "bot": false}, "content": "Ducky, it's done. I ran each script on the file it matched, so everything is hidden inside the personal files now. I put it all together in a zip with a password and saved it on my linux dev machine. I'm about to srm the loose copies so nothing is left lying around.", "timestamp": "2026-08-25T16:15:35.371000+01:00", "edited_timestamp": null, "tts": false, "mention_everyone": false, "mentions": [], "mention_roles": [], "attachments": [], "embeds": [], "pinned": false, "flags": 0}]